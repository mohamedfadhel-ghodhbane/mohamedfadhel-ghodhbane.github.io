---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WakeArrow from '../components/WakeArrow.astro';
import PostRow from '../components/PostRow.astro';
import { BASE as base, EMAIL as email, NAME, JOB_TITLE, HOME, PERSON_ID, LINKEDIN, GITHUB } from '../lib/site';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const isPublished = (entry: { data: { status: string } }) => entry.data.status === 'published';
// only finished work shows here; planned posts and projects stay in the content folder until they ship
const posts = (await getCollection('posts', isPublished))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || a.data.order - b.data.order)
  .slice(0, 3);
const projects = (await getCollection('projects', isPublished)).sort(byOrder);

const services = [
  { name: 'Security operations', text: 'SOC architecture and end-to-end tenant onboarding for Microsoft Sentinel and Defender XDR.' },
  { name: 'Detection engineering', text: 'KQL rules managed as code and deployed through CI/CD, tuned for fewer false positives and wider MITRE ATT&CK coverage.' },
  { name: 'Purple teaming', text: 'Emulating real adversary techniques against your detections, then writing rules for the gaps they expose.' },
  { name: 'Incident response', text: 'Investigations from first triage through recovery and reporting, plus playbooks your team can reuse.' },
  { name: 'Threat and vulnerability management', text: 'Threat intelligence fed into Sentinel, Tenable Nessus scanning, and critical findings driven to closure.' },
  { name: 'Cloud and network hardening', text: 'Azure hardening against CIS and Microsoft benchmarks, firewalls and F5 WAF, and ISO/IEC 27001 audits.' },
];

const tools = ['Microsoft Sentinel', 'Defender XDR', 'KQL', 'MITRE ATT&CK', 'Azure', 'Tenable Nessus', 'Fortinet', 'F5 LTM & ASM', 'LogRhythm', 'Splunk'];
const description = 'Cybersecurity engineer building detections and running security operations on Microsoft Sentinel and Defender XDR.';

// tells search engines who the site belongs to and which profiles are the same person
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: NAME,
      url: HOME,
      jobTitle: JOB_TITLE,
      description,
      email: `mailto:${email}`,
      sameAs: [LINKEDIN, GITHUB],
      knowsAbout: ['Microsoft Sentinel', 'Microsoft Defender XDR', 'KQL', 'Detection engineering', 'Security operations', 'Incident response', 'Purple teaming', 'Threat intelligence', 'Vulnerability management'],
      alumniOf: { '@type': 'CollegeOrUniversity', name: "Higher School of Communication of Tunis (Sup'Com)" },
    },
    { '@type': 'WebSite', '@id': `${HOME}#website`, url: HOME, name: NAME, inLanguage: 'en', publisher: { '@id': PERSON_ID } },
  ],
};
---
<Base title={`${NAME} · ${JOB_TITLE}`} description={description} schema={schema}>
  <section class="hero" aria-labelledby="hero-title">
    <canvas class="wake" data-wake="hero" aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title" class="display"><span>Every move</span> <span>leaves a trace.</span></h1>
        <p class="lede">I'm Mohamed Fadhel Ghodhbane, a cybersecurity engineer. I build detections and run security operations on Microsoft Sentinel and Defender XDR, and I write up what I learn along the way.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`mailto:${email}`}>Email me <WakeArrow /></a>
          <a class="btn" href={`${base}writing/`}>Read the writing <WakeArrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="work" aria-labelledby="work-title">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="work-title">What I do</h2>
        <p>Most of my work is writing the rules that catch attackers, then responding when they fire.</p>
        <p class="facts">2.5+ years across a multi-tenant SOC, a telecom operator's network, and corporate IT.</p>
      </div>
      <ul class="currents">
        {services.map((s) => (
          <li class="current">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="band" id="projects" aria-labelledby="projects-title">
      <div class="wrap split">
        <div class="split-head">
          <h2 id="projects-title">Projects</h2>
          <p>Open-source tools and references I maintain.</p>
        </div>
        <ul class="projects">
          {projects.map((p) => (
            <li class="project">
              <h3>{p.data.link ? <a href={p.data.link} target="_blank" rel="noopener">{p.data.title}</a> : p.data.title}</h3>
              <span class="state is-radiant">Live</span>
              <p>{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band" id="writing" aria-labelledby="writing-title">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="writing-title">Writing</h2>
        <p>Articles, writeups, and notes from detection and response work.</p>
        <a class="link-wake" href={`${base}writing/`}>All writing <WakeArrow /></a>
      </div>
      <ul class="post-list">
        {posts.map((post) => <PostRow post={post} />)}
      </ul>
    </div>
  </section>

  <section class="band band-quiet" id="background" aria-labelledby="background-title">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="background-title">Background</h2>
      </div>
      <div class="background">
        <p>I'm a telecommunications engineer with a Master's-level degree from Sup'Com. Before focusing on detection and response, I ran firewalls, WAF and SIEM for a telecom operator, led ISO/IEC 27001 audits, and built servers and networks for a consulting firm.</p>
        <p class="tools-lead">Tools I use most:</p>
        <ul class="tools">
          {tools.map((tool) => <li class="tag">{tool}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="close" id="contact" aria-labelledby="contact-title">
    <div class="wrap close-inner">
      <h2 id="contact-title" class="display-2">Seeing movement you can't explain?</h2>
      <p class="lede">Email is the quickest way to reach me. I'm open to consulting work and full-time security roles.</p>
      <div class="email-row">
        <a class="email-big" id="email-address" href={`mailto:${email}`}>{email}</a>
        <button class="btn btn-sm" type="button" id="copy-email" data-copy={email} data-copy-target="email-address"><span data-copy-label>Copy</span></button>
      </div>
      <div class="socials">
        <a class="link-wake" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn <WakeArrow /></a>
        <a class="link-wake" href={GITHUB} target="_blank" rel="noopener">GitHub <WakeArrow /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 13vh, 8.5rem) clamp(5rem, 13vh, 8.5rem);
  }
  .hero .wake { z-index: -1; }
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 6rem;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(246, 243, 236, 0), var(--paper));
    pointer-events: none;
  }
  .hero-copy { display: grid; gap: 1.8rem; justify-items: start; max-width: 46rem; }
  .display span { display: block; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; padding-top: 0.3rem; }

  .facts {
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    color: var(--text) !important;
    font-size: 0.98rem;
  }

  .projects { list-style: none; margin: 0; padding: 0; display: grid; }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.4rem 1.5rem;
    padding-block: 1.45rem;
    border-top: 1px solid var(--rule);
  }
  .project h3 a { text-decoration: none; }
  .project h3 a:hover { color: var(--accent); }
  .project .state { grid-column: 2; grid-row: 1; align-self: center; }
  .project p { grid-column: 1 / -1; color: var(--text-soft); max-width: 58ch; }

  .background { display: grid; gap: 1.1rem; }
  .background > p:first-child { font-size: 1.15rem; line-height: 1.6; max-width: 58ch; }
  .tools-lead { padding-top: 0.6rem; color: var(--text-soft); }
  .tools { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .close {
    padding-block: clamp(5rem, 12vh, 7.5rem);
    border-top: 1px solid var(--rule-soft);
    background: var(--panel);
  }
  .close-inner { display: grid; gap: 1.5rem; justify-items: start; }
  .close-inner .display-2 { max-width: 16ch; }
  .close-inner .lede { max-width: 44ch; }
  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; padding-top: 0.5rem; }
  .email-big {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    overflow-wrap: anywhere;
    transition: color 0.25s var(--ease-out);
  }
  .email-big:hover { color: var(--accent); }
  .socials { display: flex; flex-wrap: wrap; gap: 1rem 2.25rem; }
</style>
