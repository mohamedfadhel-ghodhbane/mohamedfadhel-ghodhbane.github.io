---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WakeArrow from '../../components/WakeArrow.astro';
import { BASE as base, NAME, HOME, PERSON_ID, OG_IMAGE, wordCount, readingMinutes } from '../../lib/site';

// Only published posts get a page; planned ones stay as entries on the writing index.
export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => p.data.status === 'published');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const typeLabel = { article: 'Article', writeup: 'Writeup', note: 'Note' }[d.type];
const dateLabel = d.date ? d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const minutes = readingMinutes(post.body);
const url = new URL(`${base}writing/${post.id}/`, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: d.title,
  description: d.summary,
  url,
  mainEntityOfPage: url,
  image: OG_IMAGE,
  datePublished: d.date?.toISOString(),
  dateModified: d.date?.toISOString(),
  author: { '@type': 'Person', '@id': PERSON_ID, name: NAME, url: HOME },
  keywords: d.tags.join(', '),
  wordCount: wordCount(post.body),
  timeRequired: `PT${minutes}M`,
  inLanguage: 'en',
};
---
<Base title={`${d.title} · ${NAME}`} description={d.summary} current="writing" type="article" published={d.date} tags={d.tags} schema={schema}>
  <article class="wrap article">
    <a class="link-wake back" href={`${base}writing/`}>All articles <WakeArrow /></a>
    <header class="article-head">
      <p class="article-meta">{typeLabel}{dateLabel && <> · <time datetime={d.date?.toISOString()}>{dateLabel}</time></>} · {minutes} min read</p>
      <h1 class="display-2">{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.tags.length > 0 && <div class="post-tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  /* minmax(0, 1fr) keeps long code lines scrolling inside their block instead of widening the page */
  .article { max-width: calc(46rem + var(--gutter) + var(--gutter-r)); padding-block: 4rem 6rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
  .article-head, .prose { min-width: 0; }
  .back { justify-self: start; }
  .article-head { display: grid; gap: 1.1rem; }
  .article-meta { font: 500 0.92rem / 1.3 var(--font-body); color: var(--text-dim); }
  .article-head .lede { max-width: none; }
  .prose { font-size: 1.08rem; line-height: 1.75; color: var(--text); }
  .prose :global(h2) { margin: 2.6em 0 0.7em; font-size: 1.75rem; }
  .prose :global(h3) { margin: 2em 0 0.5em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.15em; max-width: 68ch; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(a:hover) { color: var(--accent-hover); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; padding: 0.1em 0.35em; border-radius: 4px; background: var(--panel); }
  .prose :global(pre) { margin: 0 0 1.4em; padding: 1.1rem 1.25rem; border: 1px solid var(--rule); border-radius: 8px; overflow-x: auto; font-size: 0.9rem; line-height: 1.6; background-color: var(--code-bg) !important; }
  .prose :global(pre code) { padding: 0; background: none; }
  /* the bar site.js adds above each code block: language on the left, copy on the right */
  .prose :global(.code-block) { margin: 0 0 1.4em; border: 1px solid var(--rule); border-radius: 8px; overflow: hidden; }
  .prose :global(.code-block pre) { margin: 0; border: 0; border-radius: 0; }
  .prose :global(.code-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0.4rem 0.3rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    background: var(--panel);
  }
  .prose :global(.code-lang) { font: 600 0.8rem / 1 var(--font-body); color: var(--text-dim); }
  .prose :global(.code-copy) {
    min-height: 2.1rem;
    padding: 0 0.85rem;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--text-soft);
    font: 600 0.8rem / 1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .prose :global(.code-copy:hover) { border-color: var(--rule); color: var(--accent); }
  .prose :global(img) { width: 100%; height: auto; margin: 0.4em 0 0.6em; border: 1px solid var(--rule); border-radius: 8px; background: #ffffff; }
  .prose :global(p:has(> img)) { max-width: none; margin-bottom: 0.3em; }
  .prose :global(p > em:only-child) { display: block; font-size: 0.9rem; font-style: normal; color: var(--text-dim); }
  /* wide comparison tables scroll inside their own box instead of widening the page */
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; margin: 0 0 1.4em; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .prose :global(th), .prose :global(td) { min-width: 7rem; padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .prose :global(th) { color: var(--text-soft); font-weight: 600; border-bottom-color: var(--text-dim); }
  .prose :global(blockquote) { margin: 0 0 1.2em; padding: 0.2em 0 0.2em 1.1rem; border-left: 2px solid var(--accent); color: var(--text-soft); }
</style>
