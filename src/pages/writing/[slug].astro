---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WakeArrow from '../../components/WakeArrow.astro';
import { BASE as base, NAME, HOME, EMAIL, PERSON_ID, OG_IMAGE, wordCount, readingMinutes } from '../../lib/site';

// Only published posts get a page; planned ones stay as entries on the articles index.
export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => p.data.status === 'published');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const typeLabel = { article: 'Guide', writeup: 'Writeup', note: 'Note' }[d.type];
const dateLabel = d.date ? d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const minutes = readingMinutes(post.body);
const url = new URL(`${base}writing/${post.id}/`, Astro.site).href;
const topicHref = (tag: string) => `${base}writing/?topic=${encodeURIComponent(tag.toLowerCase())}`;

// long articles get a table of contents built from their sections
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;

// the neighbours in the same order as the articles index: newest first
const published = (await getCollection('posts', (p) => p.data.status === 'published'))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || a.data.order - b.data.order);
const index = published.findIndex((p) => p.id === post.id);
const newer = index > 0 ? published[index - 1] : undefined;
const older = index >= 0 && index < published.length - 1 ? published[index + 1] : undefined;

// a title card made by tools/og-images.py when it exists, otherwise the site-wide one
const ogFile = `og/${post.id}.jpg`;
const hasCard = existsSync(join(process.cwd(), 'public', ogFile));
const image = hasCard ? new URL(`${base}${ogFile}`, Astro.site).href : OG_IMAGE;
const imageAlt = hasCard ? `${d.title}, by ${NAME}` : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: d.title,
  description: d.summary,
  url,
  mainEntityOfPage: url,
  image,
  datePublished: d.date?.toISOString(),
  dateModified: d.date?.toISOString(),
  author: { '@type': 'Person', '@id': PERSON_ID, name: NAME, url: HOME },
  keywords: d.tags.join(', '),
  wordCount: wordCount(post.body),
  timeRequired: `PT${minutes}M`,
  inLanguage: 'en',
};
---
<Base title={`${d.title} · ${NAME}`} description={d.summary} current="writing" type="article" published={d.date} tags={d.tags} schema={schema} image={image} imageAlt={imageAlt}>
  <div class="read-progress" aria-hidden="true"><span data-progress></span></div>
  <div class:list={['wrap', 'article-layout', { 'has-toc': showToc }]}>
    <article class="article">
      <a class="link-wake back" href={`${base}writing/`}><WakeArrow /> All articles</a>
      <header class="article-head">
        <p class="article-meta">{typeLabel}{dateLabel && <> · <time datetime={d.date?.toISOString()}>{dateLabel}</time></>} · {minutes} min read</p>
        <h1 class="display-2">{d.title}</h1>
        <p class="lede">{d.summary}</p>
        {d.tags.length > 0 && <div class="post-tags">{d.tags.map((t) => <a class="tag" href={topicHref(t)}>{t}</a>)}</div>}
      </header>

      {showToc && (
        <details class="toc-inline">
          <summary>On this page</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}

      <div class="prose" data-prose>
        <Content />
      </div>

      <aside class="article-end" aria-label="About the author">
        <p class="end-name">Written by {NAME}</p>
        <p>I build detections and run security operations on Microsoft Sentinel and Defender XDR, and I'm open to consulting work and full-time security roles.</p>
        <a class="btn btn-primary" href={`mailto:${EMAIL}`}>Email me <WakeArrow /></a>
      </aside>

      {(newer || older) && (
        <nav class="pager" aria-label="More articles">
          {older && (
            <a class="pager-link prev" href={`${base}writing/${older.id}/`}>
              <span class="pager-dir">Previous</span>
              <span class="pager-title">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="pager-link next" href={`${base}writing/${newer.id}/`}>
              <span class="pager-dir">Next</span>
              <span class="pager-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>

    {showToc && (
      <aside class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol data-toc>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </aside>
    )}
  </div>
</Base>

<style>
  /* minmax(0, ...) keeps long code lines scrolling inside their block instead of widening the page */
  .article-layout { display: grid; grid-template-columns: minmax(0, 46rem); justify-content: center; column-gap: 4.5rem; padding-block: 4rem 6rem; }
  .article { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; min-width: 0; }
  .article-head, .prose { min-width: 0; }
  .back { justify-self: start; }
  .back :global(.wake-arrow) { transform: scaleX(-1); }
  .back:hover :global(.wake-arrow) { transform: scaleX(-1) translateX(4px); }
  .article-head { display: grid; gap: 1.1rem; }
  .article-meta { font: 500 0.92rem / 1.3 var(--font-body); color: var(--text-dim); }
  .article-head .lede { max-width: none; }

  /* reading progress: a thin accent line along the top edge, filled by site.js */
  .read-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 25; pointer-events: none; }
  .read-progress span { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }

  /* table of contents: a sticky rail beside the article on wide screens, a disclosure above it elsewhere */
  .toc { display: none; position: sticky; top: 6rem; align-self: start; max-height: calc(100vh - 8rem); overflow: auto; padding-left: 1.25rem; border-left: 1px solid var(--rule); }
  .toc-title { margin-bottom: 0.85rem; font: 600 0.88rem / 1.2 var(--font-body); color: var(--text); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .toc a { position: relative; display: block; font-size: 0.9rem; line-height: 1.35; color: var(--text-dim); text-decoration: none; transition: color 0.2s var(--ease-out); }
  .toc a:hover { color: var(--text); }
  .toc a[aria-current="true"] { color: var(--accent); }
  .toc a[aria-current="true"]::before { content: ""; position: absolute; left: calc(-1.25rem - 1px); top: 0.1em; bottom: 0.1em; width: 1px; background: var(--accent); }
  .toc-inline { padding: 0.85rem 1.1rem; border: 1px solid var(--rule); border-radius: 8px; background: var(--code-bg); }
  .toc-inline summary { cursor: pointer; font-weight: 600; }
  .toc-inline ol { display: grid; gap: 0.4rem; margin: 0.8rem 0 0.2rem; padding-left: 1.3rem; }
  .toc-inline a { color: var(--text-soft); text-decoration: none; }
  .toc-inline a:hover { color: var(--accent); }
  @media (min-width: 1200px) {
    .article-layout.has-toc { grid-template-columns: minmax(0, 46rem) 15rem; }
    .toc { display: block; }
    .toc-inline { display: none; }
  }

  /* end of the article: who wrote it, how to reach them, and where to go next */
  .article-end { display: grid; gap: 1rem; justify-items: start; margin-top: 1rem; padding-top: 2.25rem; border-top: 1px solid var(--rule); }
  .end-name { font: 500 1.4rem / 1.2 var(--font-display); }
  .article-end p:not(.end-name) { max-width: 56ch; color: var(--text-soft); }
  .article-end .btn { margin-top: 0.4rem; }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2.5rem; padding-top: 2rem; border-top: 1px solid var(--rule); }
  .pager-link { display: grid; gap: 0.35rem; align-content: start; text-decoration: none; }
  .pager-link.next { grid-column: 2; text-align: right; }
  .pager-dir { font: 600 0.85rem / 1 var(--font-body); color: var(--text-dim); }
  .pager-title { font: 500 1.15rem / 1.3 var(--font-display); color: var(--text); transition: color 0.2s var(--ease-out); }
  .pager-link:hover .pager-title { color: var(--accent); }
  @media (max-width: 620px) {
    .pager { grid-template-columns: minmax(0, 1fr); }
    .pager-link.next { grid-column: auto; text-align: left; }
  }

  .prose { font-size: 1.08rem; line-height: 1.75; color: var(--text); }
  .prose :global(h2) { margin: 2.6em 0 0.7em; font-size: 1.75rem; }
  .prose :global(h3) { margin: 2em 0 0.5em; }
  .prose :global(h2), .prose :global(h3) { scroll-margin-top: 5.5rem; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.15em; max-width: 68ch; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(a:hover) { color: var(--accent-hover); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; padding: 0.1em 0.35em; border-radius: 4px; background: var(--panel); }
  .prose :global(pre) { margin: 0 0 1.4em; padding: 1.1rem 1.25rem; border: 1px solid var(--rule); border-radius: 8px; overflow-x: auto; font-size: 0.9rem; line-height: 1.6; background-color: var(--code-bg) !important; }
  .prose :global(pre code) { padding: 0; background: none; }
  /* the bar site.js adds above each code block: language on the left, copy on the right */
  .prose :global(.code-block) { margin: 0 0 1.4em; border: 1px solid var(--rule); border-radius: 8px; overflow: hidden; }
  .prose :global(.code-block pre) { margin: 0; border: 0; border-radius: 0; }
  .prose :global(.code-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0.4rem 0.3rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    background: var(--panel);
  }
  .prose :global(.code-lang) { font: 600 0.8rem / 1 var(--font-body); color: var(--text-dim); }
  .prose :global(.code-copy) {
    margin-left: auto;
    min-height: 2.1rem;
    padding: 0 0.85rem;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--text-soft);
    font: 600 0.8rem / 1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .prose :global(.code-copy:hover) { border-color: var(--rule); color: var(--accent); }
  .prose :global(img) { width: 100%; height: auto; margin: 0.4em 0 0.6em; border: 1px solid var(--rule); border-radius: 8px; background: #ffffff; }
  .prose :global(p:has(> img)) { max-width: none; margin-bottom: 0.3em; }
  .prose :global(p > em:only-child) { display: block; font-size: 0.9rem; font-style: normal; color: var(--text-dim); }
  /* wide comparison tables scroll inside their own box instead of widening the page */
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; margin: 0 0 1.4em; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .prose :global(th), .prose :global(td) { min-width: 7rem; padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .prose :global(th) { color: var(--text-soft); font-weight: 600; border-bottom-color: var(--text-dim); }
  .prose :global(blockquote) { margin: 0 0 1.2em; padding: 0.2em 0 0.2em 1.1rem; border-left: 2px solid var(--accent); color: var(--text-soft); }
</style>
