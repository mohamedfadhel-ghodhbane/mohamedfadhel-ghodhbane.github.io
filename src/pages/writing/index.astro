---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';

const all = await getCollection('posts');
const posts = all
  .filter((p) => p.data.status === 'published')
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || a.data.order - b.data.order);
// a short look ahead instead of every planned topic
const upcoming = all.filter((p) => p.data.status === 'planned').sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const typeLabel = { article: 'Guide', writeup: 'Writeup', note: 'Note' };

// filters and topics only appear when they would match something
const types = new Set(posts.map((p) => p.data.type));
const filters = [
  { id: 'all', label: 'All' },
  { id: 'article', label: 'Guides' },
  { id: 'writeup', label: 'Writeups' },
  { id: 'note', label: 'Notes' },
].filter((f) => f.id === 'all' || types.has(f.id as 'article' | 'writeup' | 'note'));
const searchable = posts.map((p) => [p.data.title, p.data.summary, typeLabel[p.data.type], ...p.data.tags].join(' ').toLowerCase());
const topics = ['Sentinel', 'KQL', 'Defender XDR', 'Purple team', 'Threat intel', 'SOC metrics', 'Vulnerability management', 'Incident response']
  .filter((t) => searchable.some((text) => text.includes(t.toLowerCase())));
const entries = (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'}`;
---
<Base
  title="Articles · Mohamed Fadhel Ghodhbane"
  description="Articles on detection engineering and Microsoft security, incident writeups, and short notes by Mohamed Fadhel Ghodhbane."
  current="writing"
>
  <section class="page-head" aria-labelledby="writing-title">
    <div class="wrap head-inner">
      <h1 id="writing-title" class="display-2">Articles</h1>
      <p class="lede">Detection engineering and Microsoft security, incident writeups, and short notes. More are on the way.</p>
      <div class="finder">
        <label class="search-field">
          <span class="sr-only">Search the articles</span>
          <input id="post-search" type="search" placeholder="Search the articles" autocomplete="off" spellcheck="false" />
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </label>
        {filters.length > 2 && (
          <div class="filters" role="group" aria-label="Filter by type">
            {filters.map((f) => (
              <button class="filter" type="button" id={`filter-${f.id}`} data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>{f.label}</button>
            ))}
          </div>
        )}
      </div>
      {topics.length > 1 && (
        <div class="topics" role="group" aria-label="Topics">
          <span class="topics-label">Topics</span>
          {topics.map((t) => (
            <button class="topic" type="button" id={`topic-${t.toLowerCase().replace(/\s+/g, '-')}`} data-topic={t.toLowerCase()} aria-pressed="false">{t}</button>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="wrap list" aria-label="Posts">
    <p class="count" data-count aria-live="polite">{entries(posts.length)}</p>
    <ul class="post-list" data-posts>
      {posts.map((post) => <PostRow post={post} level="h2" />)}
    </ul>
    <p class="empty" data-empty hidden>Nothing surfaced for that search. Try another term, or clear the filters.</p>
  </section>

  {upcoming.length > 0 && (
    <section class="wrap upcoming" aria-labelledby="upcoming-title">
      <h2 id="upcoming-title" class="upcoming-title">Coming next</h2>
      <ul class="upcoming-list">
        {upcoming.map((p) => (
          <li>
            <span class="upcoming-name">{p.data.title}</span>
            <span class="state">{typeLabel[p.data.type]}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .page-head { padding-block: clamp(4rem, 10vh, 6rem) 2.5rem; }
  .head-inner { display: grid; gap: 1.5rem; justify-items: start; }
  .head-inner .lede { max-width: 52ch; }

  .finder { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1rem; width: 100%; padding-top: 0.8rem; }
  .search-field {
    position: relative;
    flex: 1 1 18rem;
    min-width: 0;
    max-width: 30rem;
    color: var(--text-dim);
  }
  .search-field input {
    width: 100%;
    height: 3.1rem;
    padding: 0 3rem 0 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--code-bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .search-field input::placeholder { color: var(--text-dim); }
  .search-field input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search-field svg { position: absolute; right: 1rem; top: 50%; width: 1.15rem; height: 1.15rem; transform: translateY(-50%); pointer-events: none; }
  .search-field:focus-within svg { color: var(--accent); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter {
    min-height: 2.6rem;
    padding: 0 1rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: transparent;
    color: var(--text-soft);
    font: 500 0.92rem / 1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out), background-color 0.25s var(--ease-out);
  }
  .filter:hover { border-color: var(--text-dim); color: var(--text); }
  .filter[aria-pressed="true"] {
    border-color: var(--text);
    background: var(--text);
    color: var(--paper);
  }

  .topics { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
  .topics-label {
    margin-right: 0.4rem;
    font: 500 0.88rem / 1 var(--font-body);
    color: var(--text-dim);
  }
  .topic {
    padding: 0.28rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    font: 500 0.82rem / 1.3 var(--font-body);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .topic:hover { border-color: var(--text-dim); color: var(--text); }
  .topic[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-hover); }

  @media (max-width: 620px) {
    .filters { flex-wrap: nowrap; width: 100%; overflow-x: auto; gap: 0.4rem; scrollbar-width: none; }
    .filter { flex: 1 0 auto; padding: 0 0.7rem; }
  }
  .list, .upcoming { max-width: calc(52rem + var(--gutter) + var(--gutter-r)); margin-left: max(0px, calc((100% - 74rem - var(--gutter) - var(--gutter-r)) / 2)); }
  .list { padding-block: 1rem 3.5rem; }
  .count {
    padding-bottom: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .empty { padding-block: 2.5rem; color: var(--text-soft); }

  .upcoming { padding-bottom: 6rem; }
  .upcoming-title {
    padding-bottom: 0.9rem;
    font: 500 1.35rem / 1.2 var(--font-display);
    color: var(--text);
  }
  .upcoming-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .upcoming-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem 1.5rem;
    padding-block: 1.05rem;
    border-top: 1px dashed var(--rule);
  }
  .upcoming-name { font-family: var(--font-display); font-size: 1.12rem; line-height: 1.35; color: var(--text-soft); }
</style>
