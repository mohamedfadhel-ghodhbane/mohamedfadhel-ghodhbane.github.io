---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/albert-sans/wght.css';
import '../styles/global.css';
import wakeSrc from '../scripts/wake.js?raw';
import siteSrc from '../scripts/site.js?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE as base, NAME, HOME, OG_IMAGE, OG_IMAGE_ALT } from '../lib/site';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'writing';
  type?: 'website' | 'article';
  published?: Date;
  tags?: string[];
  schema?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, current = 'home', type = 'website', published, tags = [], schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// "<" is escaped so a title can never close the script tag early
const jsonLd = schema && JSON.stringify(schema).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f6f3ec" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={HOME} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`${NAME}: writing`} href={`${base}rss.xml`} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline set:html={wakeSrc}></script>
    <script is:inline set:html={siteSrc}></script>
  </body>
</html>
