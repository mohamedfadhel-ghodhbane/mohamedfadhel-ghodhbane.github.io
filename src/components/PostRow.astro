---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'posts'>; level?: 'h2' | 'h3' }
const { post, level = 'h3' } = Astro.props;
const Heading = level;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const d = post.data;
const published = d.status === 'published';
const typeLabel = { article: 'Article', writeup: 'Writeup', note: 'Note' }[d.type];
const dateLabel = d.date ? d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
---
<li class="post" data-type={d.type}>
  <Heading class="post-title">
    {published
      ? <a href={`${base}writing/${post.id}/`} data-hl>{d.title}</a>
      : <span data-hl>{d.title}</span>}
  </Heading>
  <p class="post-summary" data-hl>{d.summary}</p>
  <div class="post-meta">
    <span class="post-type" data-hl>{typeLabel}</span>
    {published
      ? <span class="state is-radiant">{dateLabel || 'Published'}</span>
      : <span class="state">Planned</span>}
    {d.tags.map((tag) => <span class="tag" data-hl>{tag}</span>)}
  </div>
</li>
